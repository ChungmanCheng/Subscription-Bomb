EMAILS=email1@example.com,email2@example.com

# Search API configuration used by fully automatic Mode 1 (Tavily example)
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=your-api-key
# HTTP method: GET or POST
SEARCH_API_METHOD=POST
# Field name for the query and result limit
SEARCH_API_QUERY_PARAM=query
SEARCH_API_MAX_RESULTS_FIELD=max_results
# Leave body field blank to use Tavily's current Authorization header
SEARCH_API_KEY_BODY_FIELD=
SEARCH_API_KEY_HEADER=Authorization
SEARCH_API_KEY_PREFIX=Bearer
SEARCH_API_RESULTS_PATH=results
SEARCH_API_URL_FIELD=url
SEARCH_API_SCORE_FIELD=score

# Fully automatic Mode 1: comma-separated topics or complete search queries
AUTO_SEARCH_QUERIES=technology,finance,health,science
# Tavily supports 1-20 results per query
AUTO_RESULTS_PER_QUERY=10
# Maximum unique candidates inspected in one run
AUTO_MAX_URLS=50
# Tavily relevance threshold (0.0 disables score filtering)
AUTO_MIN_SEARCH_SCORE=0.5
# Follow promising same-site newsletter/subscribe links when a result has no form
AUTO_FOLLOW_LINKS=true
AUTO_LINKS_PER_PAGE=3
# Respect robots.txt and pace page inspection
AUTO_RESPECT_ROBOTS=true
AUTO_ROBOTS_USER_AGENT=SubscriptionBot
AUTO_REQUEST_DELAY=1.0
# Maximum time to wait for JavaScript page readiness
AUTO_PAGE_WAIT=5.0

# IMAP inbox verification (used in Verify Mode to confirm a confirmation email arrived)
# Leave blank to skip inbox verification and rely on form-submit success alone.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=email1@example.com
IMAP_PASS=your-imap-password
# Folder to watch (usually INBOX; Gmail users may need [Gmail]/All Mail)
IMAP_FOLDER=INBOX
# How long (seconds) to wait for a confirmation email before giving up
IMAP_TIMEOUT=60
